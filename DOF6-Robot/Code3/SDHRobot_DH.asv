L(1) = Link('d', 0.1245, 'a', 0.000, 'alpha', 0, 'standard');
L(2) = Link('d', 0,      'a', 0.035, 'alpha', -pi/2,     'offset', -pi/2,'standard');
L(3) = Link('d', 0,      'a', 0.146, 'alpha', 0, 'standard');
L(4) = Link('d', 0.117,  'a', 0.052, 'alpha', -pi/2,  'standard');
L(5) = Link('d', 0,      'a', 0,     'alpha', pi/2, 'standard');
L(6) = Link('d', 0.0775, 'a', 0,     'alpha', -pi/2,     'standard');

SDH_robot = SerialLink(L, 'name', 'SDHRobot');  % 直接传入Link数组

view(3)

% SDH_robot.plot([0 0 0 0 0 0]);

% 设置机器人绘图参数（可选）
SDH_robot.display

SDH_robot.teach();